# Vercel / Serverless
AI_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Gemini, solo si AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Cloudinary, subida firmada desde serverless
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=epikaja/productos

# Firebase Admin SDK
# Recomendado: pega el JSON completo de una Service Account real.
# No pegues aqui el firebaseConfig del frontend.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternativa si no usas FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CORS opcional si frontend y API estan en dominios distintos.
# Ejemplo: https://epikaja.com,https://epikaja.vercel.app
ALLOWED_ORIGINS=
